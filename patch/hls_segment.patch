+void ff_mov_precue_fragment_flush(AVFormatContext *s, const AVPacket *next_pkt)
+{
+    MOVMuxContext *mov = s->priv_data;
+    MOVTrack *trk;
+    int64_t dts, pts;
+
+    if (!next_pkt || next_pkt->stream_index < 0 ||
+        next_pkt->stream_index >= s->nb_streams)
+        return;
+
+    if (!(mov->flags & FF_MOV_FLAG_FRAGMENT) ||
+        !(mov->flags & FF_MOV_FLAG_FRAG_CUSTOM))
+        return;
+
+    trk = s->streams[next_pkt->stream_index]->priv_data;
+    if (!trk || !trk->entry || trk->start_dts == AV_NOPTS_VALUE)
+        return;
+
+    dts = next_pkt->dts;
+    pts = next_pkt->pts;
+    if (dts == AV_NOPTS_VALUE)
+        return;
+
+    if (mov->flags & FF_MOV_FLAG_NEGATIVE_CTS_OFFSETS) {
+        if (trk->dts_shift == AV_NOPTS_VALUE && pts != AV_NOPTS_VALUE)
+            trk->dts_shift = pts - dts;
+        if (trk->dts_shift != AV_NOPTS_VALUE)
+            dts += trk->dts_shift;
+    }
+
+    /* Match the FRAG_KEYFRAME branch behavior in mov_write_single_packet():
+     * end the current fragment exactly at the next fragment's first-sample dts. */
+    trk->track_duration = dts - trk->start_dts;
+    if (pts != AV_NOPTS_VALUE)
+        trk->end_pts = pts;
+    else
+        trk->end_pts = dts;
+    trk->end_reliable = 1;
+}
+
